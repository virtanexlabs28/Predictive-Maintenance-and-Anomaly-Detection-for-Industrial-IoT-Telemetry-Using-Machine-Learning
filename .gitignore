# ==========================================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# ==========================================
# Jupyter Notebooks
# ==========================================
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ==========================================
# Node.js (Thesis Document Builder)
# ==========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

