*.py[cod]
*$py.class

# Distribution / packaging
/dist/
/build/
develop-eggs/
eggs/
.eggs/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

